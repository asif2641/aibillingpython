{
  "version": 2,
  "builds": [
    {
      "src": "aibilling/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "aibilling/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "aibilling.settings.production",
    "VERCEL": "1"
  }
}
