# ──────────────────────────────────────────────
# Django core
# ──────────────────────────────────────────────

# A long, random string used to sign cookies and tokens. Change this in production!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Set to True for local development; MUST be False in production
DEBUG=True

# Comma-separated list of hostnames that can serve the app
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────

# Leave empty to use SQLite (a single file — great for development).
# For PostgreSQL on a server, set this to something like:
#   postgres://username:password@hostname:5432/database_name
DATABASE_URL=

# ──────────────────────────────────────────────
# File storage
# ──────────────────────────────────────────────

# Leave empty to store uploaded files in the local media/ folder.
# For cloud storage (needed when hosting on a free server), get a free
# Cloudinary account and paste the URL here.
CLOUDINARY_URL=

# ──────────────────────────────────────────────
# AI provider
# ──────────────────────────────────────────────

# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Or get a Claude API key from https://console.anthropic.com/
CLAUDE_API_KEY=

# Which AI to use for bill scanning: "gemini" or "claude"
AI_PROVIDER=gemini

# ──────────────────────────────────────────────
# Scan limits (to control API costs)
# ──────────────────────────────────────────────

# Maximum bill scans per user per day
DAILY_SCAN_LIMIT=50

# Maximum bill scans per user per calendar month
MONTHLY_SCAN_LIMIT=500
